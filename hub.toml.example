# 中心配置。缺这个文件不是"用默认值"，`hub serve` 会响亮失败并点名 --hub-config。
[hub]
# 必须是一块具体网卡地址（mesh/VPN 的地址），不能是 0.0.0.0：
# 0.0.0.0 会把中心暴露到所有网卡上。非回环地址默认 TLS；回环 dev 面可 `--insecure-http`。
# 本机开发用 `127.0.0.1:7420` + `hub serve --dev-loopback`。
bind = "100.64.0.10:7420"
# pair 响应与邀请票原样带这份清单；顺序就是节点的尝试顺序。
# 非回环中心必须写 https://（`hub invite` 会拒绝给 http:// 端点出票）；回环 dev 面可写 http://。
endpoints = ["https://100.64.0.10:7420"]
# 快照下行限速（字节/秒）。0 不是"不限速"，是配坏了。
max_snapshot_bps = 1572864
